{
  "name": "dsh-tes-spinner",
  "version": "0.1.0",
  "description": "A floating TES-gyro widget for the DSH web GUI: click to spin it, drag it anywhere, with a spin-speed slider and synced LRC lyrics.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "public"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "widget"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.0.0"
  }
}
